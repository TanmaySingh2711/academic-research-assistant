# Virtual environment
venv/

# Python cache (normally never created: see scripts/configure_venv.py)
__pycache__/
*.pyc

# All caches and generated files of the tools (ruff, mypy, pytest, coverage, evaluation) go to one folder
.cache/

# Secrets / local env
.env

# Generated FAISS index (keep the folder)
index/*
!index/.gitkeep

# Uploaded PDFs (keep the folder)
data/*
!data/.gitkeep

# Saved chat history (private, keep the folder)
chats/*
!chats/.gitkeep

# OS / editor files
.DS_Store
.vscode/
.idea/
