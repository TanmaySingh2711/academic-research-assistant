# Virtual environment (made by setup.bat / setup.sh)
venv/

# Your papers, the search index and your chats (made by the app, private)
storage/

# Caches of Python and the tools (ruff, mypy, pytest, coverage, evaluation)
.cache/
# Python makes these only when run without the venv helper (see scripts/configure_venv.py)
__pycache__/

# Editor and OS files
.vscode/
.DS_Store
